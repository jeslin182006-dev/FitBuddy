# Get an API key from Google AI Studio and paste it here.
GOOGLE_API_KEY=your_gemini_api_key_here

# Model names are configurable so the app can follow currently available Gemini models.
GEMINI_WORKOUT_MODEL=gemini-2.5-flash
GEMINI_TIP_MODEL=gemini-2.5-flash

# Optional. Default is a local SQLite file named fitbuddy.db.
# DATABASE_URL=sqlite:///./fitbuddy.db
